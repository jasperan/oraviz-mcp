{
    "name": "Oracle Viz MCP Server",
    "id": "oraviz-mcp",
    "version": "0.1.0",
    "description": "Sets up the environment for the Oracle Viz Model Context Protocol server",
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "description": "Version of the OraViz MCP server to install (defaults to latest)"
        },
        "oracleUser": {
            "type": "string",
            "default": "system",
            "description": "Oracle database user"
        },
        "oraclePassword": {
            "type": "string",
            "default": "",
            "description": "Password for the Oracle database user (empty by default, must be specified at runtime)"
        },
        "oracleHost": {
            "type": "string",
            "default": "localhost",
            "description": "Oracle database hostname"
        },
        "oraclePort": {
            "type": "string",
            "default": "1521",
            "description": "Oracle listener port"
        },
        "oracleService": {
            "type": "string",
            "default": "FREEPDB1",
            "description": "Oracle service name"
        },
        "oravizMcpRepo": {
            "type": "string",
            "default": "https://github.com/jasperan/oraviz-mcp",
            "description": "OraViz MCP repository URL"
        }
    },
    "dependsOn": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "postCreateCommand": "docker build -t oraviz-mcp /opt/oraviz-mcp/.",
    "customizations": {
        "vscode": {
            "settings": {
                "mcp": {
                    "servers": {
                        "oraviz-mcp": {
                            "type": "stdio",
                            "command": "docker",
                            "args": [
                                "run",
                                "--rm",
                                "-i",
                                "-e",
                                "ORACLE_USER",
                                "-e",
                                "ORACLE_PASSWORD",
                                "-e",
                                "ORACLE_HOST",
                                "-e",
                                "ORACLE_PORT",
                                "-e",
                                "ORACLE_SERVICE",
                                "oraviz-mcp"
                            ],
                            "envFile": "${userHome}/.oraviz-mcp-env"
                        }
                    }
                }
            }
        }
    }
}
