# Required: Oracle AI Database credentials
ORACLE_USER=system
ORACLE_PASSWORD=your_password

# Connection target (defaults shown)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Optional: full EZConnect descriptor; overrides host/port/service
# ORACLE_DSN=myhost:1521/FREEPDB1

# Optional: Oracle wallet (Autonomous Database / mTLS)
# ORACLE_CONFIG_DIR=/wallet
# ORACLE_WALLET_LOCATION=/wallet/credentials
# ORACLE_WALLET_PASSWORD=wallet_password

# Optional: context-engineering and safety caps
ORACLE_MCP_MAX_ROWS=500
ORACLE_MCP_PREVIEW_ROWS=25
ORACLE_MCP_MAX_CELL_CHARS=500

# Optional: MCP server transport (stdio is the default)
ORACLE_MCP_SERVER_TRANSPORT=stdio
ORACLE_MCP_BIND_HOST=127.0.0.1
ORACLE_MCP_BIND_PORT=8080

# Optional: logging (json is the default; set LOG_FORMAT=console for humans)
# LOG_FORMAT=json
# LOG_LEVEL=20
